# Safe defaults required by CURRENT_DECISIONS.md
PAPER_ONLY=true
LIVE_TRADING=false
WALLET_ENABLED=false
SIGNING_ENABLED=false
BROADCAST_ENABLED=false
TELEGRAM_ENABLED=false

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# Isolated runtime paths
PAPER_DB_PATH=data/solana/paper/runtime.db
SHADOW_DB_PATH=data/solana/shadow/runtime.db
PAPER_AUDIT_LOG_PATH=data/solana/paper/events.jsonl
SHADOW_AUDIT_LOG_PATH=data/solana/shadow/events.jsonl
RUNTIME_CONTROL_PATH=data/solana/runtime_control.json
RUNTIME_LOCK_DIR=data/solana/locks

# Real providers are intentionally empty until Stage B interface review.
SOLANA_RPC_URL=
SOLANA_WS_URL=
JUPITER_QUOTE_URL=
JUPITER_API_KEY=
JUPITER_PRICE_IMPACT_UNIT=
JUPITER_SLIPPAGE_BPS=50
JUPITER_QUOTE_TTL_MS=1500
TOKEN_DECIMALS_JSON=

# Realtime runner
POLL_INTERVAL_SEC=10
BINANCE_MEME_RANK_TYPE=10
BINANCE_MEME_LIMIT=40

# Optional Gate A Telegram Paper/Shadow controls; remain disabled by default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 3 is read-only Binance Web3 only. Public official endpoints use no
# wallet/Jupiter credential; keep DATA_SOURCE=fixture unless a bounded probe is
# explicitly requested.
DATA_SOURCE=fixture
BINANCE_WEB3_BASE_URL=https://web3.binance.com
BINANCE_WEB3_KLINE_BASE_URL=https://dquery.sintral.io
BINANCE_WEB3_TIMEOUT_SEC=10
BINANCE_WEB3_MAX_RETRIES=1
BINANCE_WEB3_MAX_RESPONSE_BYTES=1000000
