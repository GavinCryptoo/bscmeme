# meme0801 environment template
#
# Copy this file to .env for local use and replace only the blank values that
# are required by the selected mode. Never commit .env or paste real secrets
# into this template.

# ===== Data source and execution safety =====
# fixture is deterministic and safe for tests; replay/binance_web3 are
# read-only data-source options.
DATA_SOURCE=fixture
# Paper/Shadow defaults: no wallet, signing, broadcast, or live execution.
PAPER_ONLY=true
LIVE_TRADING=false
WALLET_ENABLED=false
SIGNING_ENABLED=false
BROADCAST_ENABLED=false
TELEGRAM_ENABLED=false
BSC_LIVE_ENABLED=false

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# Isolated runtime paths
PAPER_DB_PATH=data/solana/paper/runtime.db
SHADOW_DB_PATH=data/solana/shadow/runtime.db
PAPER_AUDIT_LOG_PATH=data/solana/paper/events.jsonl
SHADOW_AUDIT_LOG_PATH=data/solana/shadow/events.jsonl
RUNTIME_CONTROL_PATH=data/solana/runtime_control.json
RUNTIME_LOCK_DIR=data/solana/locks

# Isolated BSC Paper/Shadow paths. BSC Live, wallets, signing, broadcast and
# real transactions remain disabled.
BSC_DATA_DIR=data/bsc
BSC_PAPER_DB_PATH=data/bsc/paper/runtime.db
BSC_SHADOW_DB_PATH=data/bsc/shadow/runtime.db
BSC_PAPER_AUDIT_LOG_PATH=data/bsc/paper/events.jsonl
BSC_SHADOW_AUDIT_LOG_PATH=data/bsc/shadow/events.jsonl
BSC_RUNTIME_CONTROL_PATH=data/bsc/runtime_control.json
BSC_PAPER_HEALTH_PATH=data/bsc/paper/health.json
BSC_SHADOW_HEALTH_PATH=data/bsc/shadow/health.json
BSC_RUNTIME_LOCK_DIR=data/bsc/locks
# BSC Live is fully isolated from Paper/Shadow.
BSC_LIVE_DB_PATH=data/bsc/live/runtime.db
BSC_LIVE_AUDIT_LOG_PATH=data/bsc/live/events.jsonl
BSC_LIVE_CONTROL_PATH=data/bsc/live/runtime_control.json
BSC_LIVE_HEALTH_PATH=data/bsc/live/health.json
BSC_LIVE_ARCHIVE_DIR=data/bsc/live/archive
BSC_LIVE_LOCK_DIR=data/bsc/live/locks
# Optional read-only EVM WSS. The runner subscribes only to Pair Swap/Sync
# logs for active BSC positions; unset or failed WSS falls back to 2s polling.
BSC_WSS_URL=
BSC_BACKUP_WSS_URLS=
# BSC Paper/Shadow use only read-only on-chain quotes.  Binance remains a
# Dashboard reference and never contributes an entry, exit, or PnL price.
BSC_EXECUTABLE_QUOTE_ENABLED=true

# ===== BSC RPC and Live configuration =====
# BSC_RPC_URL is the normal HTTP RPC; BSC_LOGS_RPC_URL is optional and used
# for log queries/gap fill. Leave credentials blank in this example.
# To run BSC Live, explicitly set PAPER_ONLY=false together with
# LIVE_TRADING=true and BSC_LIVE_ENABLED=true. These modes cannot overlap.
BSC_RPC_URL=
BSC_LOGS_RPC_URL=
BSC_PRIVATE_KEY=
BSC_TRADE_AMOUNT_BNB=
BSC_MAX_POSITIONS=
BSC_SLIPPAGE_BPS=
# Safe first-run default: one entry total. Set 0 only when intentionally unlimited.
BSC_LIVE_MAX_ENTRIES=1
BSC_TRADE_DEADLINE_SEC=60
# Balanced Live execution provider. Credentials stay only in local .env.
BSC_LIVE_TRADE_AMOUNT_BNB=0.001
# Use BITGET_WALLET_ORDER_MODE or GMGN_CLI. GMGN keeps its credentials in the
# official local CLI configuration; never put them in this file.
BSC_BALANCED_ROUTE_PROVIDER=BITGET_WALLET_ORDER_MODE
# Live-only cap. The Paper Balanced cap remains strategy-controlled.
BSC_BALANCED_LIVE_MAX_OPEN_POSITIONS=2
GMGN_BSC_WALLET_ADDRESS=
GMGN_CLI_BIN=gmgn-cli
GMGN_CLI_TIMEOUT_SEC=20
GMGN_SLIPPAGE_PCT=30
GMGN_GAS_RESERVE_BNB=0.003
GMGN_EXECUTION_DB_PATH=data/bsc-balanced/live/gmgn_execution.db
BITGET_WALLET_API_HOST=https://bopenapi.bgwapi.io
BITGET_WALLET_API_KEY=
BITGET_WALLET_API_SECRET=
BITGET_WALLET_CHAIN=bnb
BITGET_WALLET_CHAIN_ID=56
BITGET_WALLET_TIMEOUT_SEC=15
BITGET_WALLET_RESPONSE_VERIFICATION=true
BITGET_GAS_RESERVE_BNB=0.003
BITGET_EXECUTION_DB_PATH=data/bsc-balanced/bitget-live/bitget_execution.db

# ===== Solana read-only configuration =====
# The first URL is primary; backups are tried in
# order after connection, HTTP, schema, or provider errors. Extra backups may
# be supplied as a comma-separated list. Values are never printed by status.
SOLANA_RPC_URL=
SOLANA_BACKUP_RPC_URL=
SOLANA_RPC_BACKUP_URLS=
SOLANA_WS_URL=
SOLANA_BACKUP_WS_URL=
SOLANA_WS_BACKUP_URLS=
JUPITER_QUOTE_URL=
JUPITER_API_KEY=
JUPITER_PRICE_IMPACT_UNIT=
JUPITER_SLIPPAGE_BPS=50
JUPITER_QUOTE_TTL_MS=1500
TOKEN_DECIMALS_JSON=
TOKEN_DECIMALS_CACHE_PATH=data/solana/token_decimals_cache.json

# Realtime runner
POLL_INTERVAL_SEC=10
BINANCE_MEME_RANK_TYPE=10
BINANCE_MEME_LIMIT=40

# Optional Telegram notifications and safe new-entry controls; disabled by default.
# BSC Live Telegram controls cannot place orders, change risk, or stop the process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ===== Binance Web3 read-only configuration =====
# Public official endpoints use no wallet/Jupiter credential; keep
# DATA_SOURCE=fixture unless a bounded probe is explicitly requested.
BINANCE_WEB3_BASE_URL=https://web3.binance.com
BINANCE_WEB3_KLINE_BASE_URL=https://dquery.sintral.io
BINANCE_WEB3_TIMEOUT_SEC=10
BINANCE_WEB3_MAX_RETRIES=1
BINANCE_WEB3_MAX_RESPONSE_BYTES=1000000
